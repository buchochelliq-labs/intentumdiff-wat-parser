# Bundled parser metadata for the IntentumDiff language-info API.
# Plugin code exposes this data; the host still owns trust and provenance.

[plugin]
author = IntentumDiff
plugin_version = 0.1.0
last_updated = 2026-05-19

[language.wat]
language_name = WebAssembly Text
language_short_name = WAT
monaco_language = plaintext
default_filename = module.wat
language_file_extensions = .wat

[language.wast]
language_name = WebAssembly Text
language_short_name = WAST
monaco_language = plaintext
default_filename = module.wast
language_file_extensions = .wast
